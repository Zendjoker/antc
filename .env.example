# ---- API keys (only needed for the paid options) ----
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...       # the cheap model for most turns (see Cost below)
DEEPGRAM_API_KEY=...            # not needed if STT_PROVIDER=whisper
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=nPczCjzI2devNBz1zQrb   # Brian. Others: George JBFqnCBsd6RMkjVDRZzb, Sarah EXAVITQu4vr4xnSDxMaL, Daniel onwK4e9ZLuTAKqWW03F9
ELEVENLABS_MODEL=eleven_v4_turbo   # expressive (soft, excited, serious...) and fast. Plain and cheaper: eleven_flash_v2_5. Most natural reading: eleven_multilingual_v2
OUTPUT_SAMPLE_RATE=24000                 # free plan max. 44100 needs a paid ElevenLabs plan
ELEVENLABS_FALLBACK_MODEL=eleven_flash_v2_5   # used if the model above is refused (400/404/422); words only, no tags
ELEVENLABS_TEXT_NORMALIZATION=auto      # auto | on | off: how ElevenLabs reads numbers/dates (tests/tts_bench.py compares)
ELEVENLABS_SEED=                        # a number makes the same request sound the same (A/B listening); empty = varied
SPEECH_DEBUG=0                          # 1: log each sentence's SEMANTIC text, strategy, PERFORMANCE script, model
SOCIAL_MEANING=1                        # read what they MEAN for how to answer (small local model, ~23 MB, a few ms)

# ---- Brains ----
# claude (paid API, smartest) or ollama (free, runs on your own GPU)
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:14b          # 16GB GPU: qwen3:14b. 8GB GPU: qwen3:8b. No GPU: qwen3:4b
OLLAMA_KEEP_ALIVE=30m

# ---- Cost: which model answers, and how much it may spend ----
# Most turns go to a cheap OpenAI model; Claude handles what matters and takes over if OpenAI fails.
# Both get the same truth rules, tools and claim checks. Watch the log for "model: ..." and "turn cost: ...".
LLM_DEFAULT=openai             # openai (cheap, needs OPENAI_API_KEY) | claude
LLM_SMART=claude               # model for important requests
OPENAI_MODEL=gpt-5-mini        # $0.25/$2 per 1M tokens. gpt-5-nano ($0.05/$0.40) is cheaper but follows the rules less reliably
OPENAI_MEMORY_MODEL=           # background memory work. Blank = same as OPENAI_MODEL
OPENAI_REASONING=minimal       # GPT-5 thinking effort: minimal is fastest and cheapest
LLM_SMART_TRIGGERS=ask claude,use claude,smart model,think hard,think it through,think carefully,really think
LLM_COMPLEX_TOPICS=help me plan,make a plan,help me decide,should i,pros and cons,compare,step by step,explain why,in detail,advice on,give me advice,strategy
LLM_COMPLEX_WORDS=35           # requests at least this long go to the smart model
DAILY_BUDGET_USD=1.00          # all paid models together, per day (0 = no limit). Today's spend: spend.json / --check
BUDGET_FALLBACK=ollama         # past the budget: ollama (free local model, if running) | stop
PROMPT_CACHE=1                 # Claude: the fixed part of every request is billed at 10% after the first
MAX_HISTORY=16                 # messages of conversation sent with each request
MAX_TOKENS_REPLY=450           # ceilings only: spoken replies are short
MAX_TOKENS_MEMORY=400
MAX_TOKENS_SUMMARY=150
MEMORY_BATCH=1                 # learn facts once per conversation instead of after every exchange

# ---- Cognition: how much reasoning a request gets (room_agent/cognition/) ----
REFLEX=1                       # simple commands ("open Spotify", "volume down") run with no model call at all
LEVEL_DEEP=smart               # who answers DEEP requests ("investigate...", "think hard"): smart (LLM_SMART) | default
OLLAMA_MODEL_DEEP=             # Ollama setups: a stronger model for DEEP requests (blank = OLLAMA_MODEL)
COG_MAX_TOOL_ROUNDS=6          # one request: at most this many rounds of tool use, then it stops and reports honestly
COG_MAX_TOOL_CALLS=14
COG_MAX_TURN_S=90
COG_MAX_RETRIES=2              # the same failing action at most this many times per goal

# ---- Personality ----
USER_NAME=Adam
# Speed vs brains: claude-haiku-4-5-20251001 (fast) or claude-sonnet-5-5 (smarter)
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ---- Voice ----
# elevenlabs (paid/limited free tier, most natural) or piper (free, local, unlimited)
TTS_PROVIDER=piper
PIPER_VOICE=en_US-ryan-high     # others: en_US-lessac-high, en_GB-alan-medium, en_US-amy-medium

# ---- Audio ----
# Name fragment or index from: python main.py --list-devices   (blank = system default)
MIC_DEVICE=
SPEAKER_DEVICE=
FOLLOW_DEFAULT_DEVICE=1           # with MIC/SPEAKER_DEVICE blank: switch live when the Windows default changes (headphones...)
# Built-in options: hey_jarvis, alexa, hey_mycroft, or a path to your own .onnx model
WAKE_WORD=hey_jarvis
WAKE_THRESHOLD=0.5
WAKE_SOUND=assets/sounds/wake.mp3        # played when it wakes up (mp3/wav). Blank = short beep
SPEECH_RMS=500                  # set from: python -m room_agent.calibrate
SILENCE_S=0.8                   # pause length that ends your turn
ECHO_CANCELLATION=1            # remove the agent's own voice from the mic (WebRTC). Lets you interrupt it
NOISE_SUPPRESSION=1            # remove fans, hum, hiss
BARGE_IN=1                     # talk over the agent to cut it off. 0 = it always finishes its sentence
VAD_THRESHOLD=0.5              # voice detector confidence (0-1). Raise if background noise counts as talking

# ---- Presence: how Jarvis behaves when you're quiet ----
# asleep (wake word only) -> "hey jarvis" -> awake (no wake word needed) -> long silence -> goodbye -> asleep
WAKE_ACK_DELAY=0.7             # after "hey jarvis", wait this long for a command before saying "yeah?"
WAKE_GUARD_S=1.0               # ignore the wake word this long after Jarvis stops talking
CHECKIN_AFTER_S=20             # quiet this long mid-conversation -> maybe "you good?"
CHECKIN_CHANCE=0.6             # 0-1, so check-ins don't happen like clockwork
CHECKIN_COOLDOWN_S=180         # at least this long between check-ins
MAX_CHECKINS=1                 # per conversation
SLEEP_AFTER_S=45               # quiet this long -> says goodbye and goes back to sleep
SLEEP_AFTER_CHECKIN_S=12       # no answer to a check-in -> sleep after this
SLEEP_GRACE_S=2                # start talking within this long after the goodbye and it stays awake
WAKE_SOUND_ON=startup          # when to play WAKE_SOUND: startup | wake (every "hey jarvis", adds ~2.5s) | off
BARGE_MIN_SPEECH_MS=240        # how much of your voice it takes to interrupt Jarvis (higher = harder)
BARGE_VAD=0.6                  # voice-detector confidence needed to interrupt (higher = harder)
BARGE_VERIFY=1                 # double-check an interruption with Whisper: Jarvis's own echo, noise and
                               # breathing get rejected, only your words stop him (needs STT_PROVIDER=whisper)
QUIET_ALLOWS_TIMERS=1          # in quiet mode, timers you set still ring (0 = total silence)

# ---- Memory ----
# Jarvis remembers what you tell him automatically (memory.db, a local SQLite database) and picks up
# recent conversations after a restart. See what it knows: python main.py --memory
RECENT_HOURS=12                # after a restart, continue conversations from the last this-many hours
MEMORY_MODEL=                  # model that decides what to remember. Blank = same as CLAUDE_MODEL

# ---- Thinking sound ----
LOADING_SOUND=assets/sounds/loading.mp3   # looped while Jarvis thinks or looks something up. Blank = off
LOADING_VOLUME=0.5             # 1.0 = the file's own volume
LOADING_DELAY=0.6              # only play it if the answer takes longer than this

# ---- Speech-to-text ----
# deepgram (cloud, best accuracy) or whisper (local, free, private; pip install -r requirements/local.txt)
STT_PROVIDER=whisper
WHISPER_MODEL=large-v3-turbo  # base.en on CPU, large-v3-turbo on a GPU (small.en if short on VRAM), tiny.en on a Pi
WHISPER_DEVICE=cpu             # cuda = NVIDIA GPU (pip install -r requirements/gpu.txt), otherwise cpu
FILLERS=1                      # fill slow answers with "mm" / "one sec". 0 = off
FILLER_DELAY=1.0               # only fill silences longer than this. Raise to hear fillers less

# ---- Optional ----
WEATHER_LOCATION=               # e.g. Chicago
UNITS=imperial                  # or metric
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
HA_SENSITIVE_ENTITIES=          # entities that always need your yes even if they look harmless, e.g. switch.garage_opener
                                # (locks, alarms, covers, scripts, automations and scenes always do)

# --- Connections ---
# Google (Gmail + Calendar): a Google Cloud OAuth client of type "Desktop app". Connect in the dashboard
# (Settings -> Connections) or with: python main.py --connect google. Tokens go to Windows Credential Manager.
GOOGLE_CLIENT_ID=                # ...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=            # GOCSPX-... (for desktop apps Google doesn't treat this as a real secret)
# GOOGLE_CLIENT_FILE=google_client.json   # or point to the downloaded client JSON instead of the two lines above
BACKGROUND_SYNC=0                # future "tell me when..." features; nothing polls your inbox now

# --- Location ---
LOCATION_SOURCE=auto            # auto (Windows location, then your internet connection's city) / windows / ip / off

# --- Phone mode (phone.md) ---
PHONE_MODE=0                    # 1: Jarvis on your phone + calls you while you drive (only for important things)
PUBLIC_URL=                     # e.g. https://my-pc.tail1234.ts.net (Tailscale Funnel to port 8770)
PHONE_TOKEN=                    # made by: python main.py --setup-phone
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=                  # Jarvis's number, +1...
MY_PHONE=                       # your number with its country code, +1... (the only number Jarvis answers or calls)
PHONE_TRUSTED_ATTESTATION=A     # caller ID can be faked: a call from MY_PHONE is trusted only if the carrier vouches (STIR/SHAKEN A)
PHONE_PIN=                      # digits; lets an unverified call in after you say it (no PIN: such calls are declined)
VIP_SENDERS=                    # emails from these are always worth a call: name or address, comma separated
CALL_COOLDOWN_MIN=10

# ---------- Zigbee sensors and lights (Zigbee2MQTT on this PC) ----------
ZIGBEE=1                    # 0 = ignore Zigbee devices
ZIGBEE_ALIASES=             # your names for devices, e.g. bed=Vibration sensor, desk light=LED strip
ZIGBEE2MQTT_DIR=            # e.g. C:\Users\you\zigbee2mqtt (the folder with start.bat): Jarvis starts it when it starts

# ---------- greeting you when you come home (needs the door sensor) ----------
GREET_ON_ARRIVAL=1          # 0 = never greet on its own
GREET_AWAY_MIN=10           # the room must have been quiet this many minutes (so it's an arrival, not you leaving)
GREET_COOLDOWN_MIN=30       # at most one greeting this often
QUIET_HOURS=                # e.g. 23-7: nothing proactive is spoken then (your alarms and timers still ring)

# Live diagnostic mode: one JSON line per event in logs/ (speech, state, barge-in timing, tools, turn latency); secrets redacted
DIAGNOSTICS=0

# Computer interaction: browsers (Opera, Opera GX, Chrome, Edge, Firefox, Brave), page reading, clicking, research
BROWSER_CONTROL=1
SCREEN_VISION=ask           # off | ask (asks you once before the first screenshot goes to the vision model) | allow
VISION_PROVIDER=auto        # auto | claude | openai | off
VISION_MODEL=               # blank = the normal model

# Lists, reminders at moments, nudges
DESK_AWAY_MIN=10            # minutes without keyboard/mouse = away from the PC ("remind me when I'm back at my PC")
BREAK_REMINDER_MIN=180      # nonstop PC use before suggesting a break (0 = off)
RAIN_ALERT=1                # mention likely rain when you leave
MEETING_ALERT_MIN=10        # heads-up before calendar events (0 = off; needs Google Calendar)
PLAN_FOLLOWUPS=1            # mention a remembered plan the morning it's due

# Safety
EMERGENCY_HOTKEY=ctrl+alt+j # stops everything Jarvis is doing, from anywhere (leave empty to turn off)

# Missions: background business research + demo websites (room_agent/missions/). Files go to MISSIONS_DIR, not the repo.
MISSIONS_DIR=               # blank = Documents\Jarvis Missions
MISSION_DEFAULT_BUDGET_USD=1.00   # per mission, unless you name one; the mission pauses before spending more
MISSION_MAX_BUDGET_USD=10.00      # hard ceiling for any mission
MISSION_LIGHT_MODEL=        # blank = OPENAI_MODEL (only used when MISSION_LLM_COPY=1)
MISSION_STRONG_MODEL=claude-sonnet-5-5   # demo-site edits when CODER_BACKEND=anthropic
MISSION_LLM_COPY=0          # 1 = a cheap model polishes outreach wording (facts re-checked); 0 = templates only (free)
GOOGLE_PLACES_API_KEY=      # optional, paid per request: better discovery. Blank = OpenStreetMap only (free)
PLACES_COST_PER_REQUEST=0.035          # USD per Text Search page (check your Google pricing; counted per request)
PLACES_DETAILS_COST_PER_REQUEST=0.025  # USD per Place Details re-fetch (after the in-memory copy expires)
PLACES_MEMORY_TTL_S=21600              # Google Places content is kept in memory only, this long (never on disk)
MISSION_PREVIEW_PORT=8790   # demo previews on 127.0.0.1 only
CODER_BACKEND=auto          # auto (= anthropic if there's a key) | anthropic | claude_cli (explicit only) | none
CODER_CLI=claude            # the Claude Code command (claude_cli)
CODER_MODEL=                # claude_cli model; blank = its default
CODER_TIMEOUT_S=600
CODER_MAX_USD=1.00          # budget reserved per Claude Code edit (its cost is only known afterwards)
CODER_SANDBOX_DIR=          # blank = %TEMP%\jarvis-coder (throwaway copies the worker edits)
# You, as shown in outreach drafts (a postal address is required in commercial email: CAN-SPAM)
MISSION_SENDER_NAME=
MISSION_SENDER_BUSINESS=
MISSION_SENDER_EMAIL=
MISSION_SENDER_PHONE=
MISSION_SENDER_ADDRESS=
